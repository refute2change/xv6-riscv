     memset((char*)r, 5, PGSIZE); // fill with junk
+    // advanced task - initialize reference count by 1
+    acquire(&ref.lock);
+    ref.count[(uint64)r / PGSIZE] = 1;
+    release(&ref.lock);
+  }
   return (void*)r;
 }
+
+// advanced task - add a reference to a physical page
+void
+kaddref(void *pa)
+{
+  acquire(&ref.lock);
+  ref.count[(uint64)pa / PGSIZE]++;
+  release(&ref.lock);
