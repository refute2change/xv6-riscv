+
+void
+format_line_index(char *buf, int val)
+{
+    for(int i = 0; i < 10; i++) {
+        buf[i] = ' ';
+    }
+    buf[10] = '\0';
+
+    if (val == 0) {
+        buf[7] = '0';
+        return;
+    }
+
+    int i = 7; 
+    while (val > 0 && i >= 0) {
+        buf[i] = (val % 10) + '0'; 
+        val /= 10;
+        i--;
+    }
+    
+    if (val > 0){
+      fprintf(2, "format_line_index() - too many lines\n");
+      exit(-1);
+    }
+}
 
