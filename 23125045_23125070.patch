+        fprintf(2, "readline() - line too long\n");
+        exit(-1);
+    }
+  }
+
+  if (((n == 0) && (i == 0)) || (n < 0)){
+    return n;
+  }
+
+  i += 1;
+  buf[i] = '\0';
+  return i;
